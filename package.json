{
	"name": "@tstibbs/school-assistant",
	"private": true,
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "22",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.5.1",
			"onFail": "error"
		}
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "^3.1136.0",
		"@aws-sdk/client-s3": "^3.1136.0",
		"@aws-sdk/client-sns": "^3.1136.0",
		"@thednp/dommatrix": "^3.1.2",
		"@tstibbs/cloud-core-utils": "github:tstibbs/cloud-core#path:/aws/utils",
		"ask-sdk-core": "^2.14.0",
		"constructs": "^10.8.1",
		"dotenv": "^16.6.1",
		"js-yaml": "^5.4.2",
		"lodash-es": "^4.18.1",
		"pdfjs-dist": "^5.5.207"
	},
	"devDependencies": {
		"aws-cdk": "2.1142.0",
		"aws-cdk-lib": "2.270.0",
		"esbuild": "^0.28.2",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8"
	},
	"scripts": {
		"test:unit": "node --experimental-vm-modules --nolazy ./node_modules/jest/bin/jest.js --selectProjects unit",
		"test:cdk": "node --experimental-vm-modules --nolazy ./node_modules/jest/bin/jest.js --selectProjects cdk",
		"test:ci": "pnpm run test:unit && pnpm run test:cdk",
		"deploy": "pnpm exec cdk-tools diffploy",
		"prepare": "husky .config/husky"
	}
}
